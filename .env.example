# Core
APP_ENV=development
APP_NAME=TehranNetwork
APP_SHORT_NAME=TehranNetwork
APP_BASE_URL=https://tunnel.softarg.ir
APP_SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
JWT_SECRET_KEY=CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_VALUE
JWT_EXPIRE_MINUTES=30
WEB_BIND_PORT=18080
MAX_CONCURRENT_JOBS=2

# PostgreSQL
POSTGRES_DB=netauto
POSTGRES_USER=netauto
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
DATABASE_URL=postgresql+psycopg://netauto:CHANGE_ME_POSTGRES@postgres:5432/netauto

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS
REDIS_URL=redis://:CHANGE_ME_REDIS@redis:6379/0

# First SUPER_ADMIN
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ADMIN
BOOTSTRAP_ADMIN_EMAIL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ENABLED=false
TELEGRAM_POLLING=true
TELEGRAM_API_BASE=http://api:8000
BOT_INTERNAL_API_KEY=CHANGE_ME_BOT_INTERNAL_API_KEY

# Email - temporary Gmail SMTP
EMAIL_ENABLED=false
EMAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=TehranNetwork
SMTP_STARTTLS=true

# Billing is intentionally disabled in development
BILLING_MODE=development
PAYMENTS_ENABLED=false
DEFAULT_CURRENCY=USDT
SECONDARY_CURRENCY=IRT
