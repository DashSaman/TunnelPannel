{
  "id": "openvpn",
  "name": "OpenVPN",
  "family": "vpn",
  "version": "2.6",
  "maturity": "STANDARD",
  "layer": "L3",
  "transport": [
    "tcp",
    "udp"
  ],
  "requires": [
    "TCP_STREAM",
    "UDP_DATAGRAM"
  ],
  "provides": [
    "L3_INTERFACE",
    "TUN_INTERFACE"
  ],
  "required_binaries": [
    "openvpn"
  ],
  "required_kernel_modules": [
    "tun"
  ],
  "required_privileges": "CAP_NET_ADMIN",
  "ports": {
    "udp": "any",
    "tcp": "any"
  },
  "ip_protocols": [],
  "ipv4": true,
  "ipv6": true,
  "tun": true,
  "tap": false,
  "socks": false,
  "http_proxy": false,
  "reverse": false,
  "raw_ip": false,
  "encryption": "AES-256-GCM / TLS",
  "mtu_overhead": 70,
  "can_be_overlay": true,
  "can_be_underlay": true,
  "can_be_nested": true,
  "repeatable": false,
  "known_limitations": [
    "higher CPU than WireGuard at same throughput"
  ],
  "verification": "REAL_PAIR_VERIFIED",
  "supported_os": [
    "linux"
  ],
  "supported_arch": [
    "amd64",
    "arm64"
  ],
  "implementation_status": "IMPLEMENTED"
}
