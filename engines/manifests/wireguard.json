{
  "id": "wireguard",
  "name": "WireGuard",
  "family": "vpn",
  "version": "1.0",
  "maturity": "STANDARD",
  "layer": "L3",
  "transport": [
    "udp"
  ],
  "requires": [
    "UDP_DATAGRAM"
  ],
  "provides": [
    "L3_INTERFACE",
    "TUN_INTERFACE"
  ],
  "required_binaries": [
    "wg",
    "wg-quick"
  ],
  "required_kernel_modules": [
    "wireguard"
  ],
  "required_privileges": "CAP_NET_ADMIN",
  "ports": {
    "udp": "any"
  },
  "ip_protocols": [],
  "ipv4": true,
  "ipv6": true,
  "tun": true,
  "tap": false,
  "socks": false,
  "http_proxy": false,
  "reverse": false,
  "raw_ip": false,
  "encryption": "ChaCha20-Poly1305",
  "mtu_overhead": 80,
  "can_be_overlay": true,
  "can_be_underlay": true,
  "can_be_nested": true,
  "repeatable": true,
  "known_limitations": [
    "needs kernel >= 5.6 or DKMS"
  ],
  "verification": "REAL_PAIR_VERIFIED",
  "supported_os": [
    "linux"
  ],
  "supported_arch": [
    "amd64",
    "arm64"
  ],
  "implementation_status": "IMPLEMENTED"
}
