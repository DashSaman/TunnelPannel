{
  "id": "hedioum",
  "name": "Hedioum",
  "family": "custom",
  "version": "1.x",
  "maturity": "EXPERIMENTAL",
  "layer": "L3",
  "transport": [
    "tcp"
  ],
  "requires": [
    "TCP_STREAM"
  ],
  "provides": [
    "L3_INTERFACE",
    "TUN_INTERFACE",
    "SOCKS5_PROXY"
  ],
  "required_binaries": [
    "hedioum"
  ],
  "required_kernel_modules": [
