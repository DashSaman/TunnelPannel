{
  "id": "backhaul",
  "name": "Backhaul",
  "family": "reverse",
  "version": "0.7.2",
  "maturity": "ADVANCED",
  "layer": "L4",
  "transport": [
    "tcp"
  ],
  "requires": [
    "TCP_STREAM"
  ],
  "provides": [
    "TCP_STREAM",
    "REVERSE_TCP"
  ],
  "required_binaries": [
    "backhaul"
  ],
  "required_kernel_modules": [],
  "required_privileges": "CAP_NET_ADMIN",
  "ports": {
    "tcp": "any"
  },
  "ip_protocols": [],
  "ipv4": true,
  "ipv6": true,
  "tun": false,
  "tap": false,
  "socks": false,
  "http_proxy": false,
  "reverse": true,
  "raw_ip": false,
  "encryption": "none",
  "mtu_overhead": 0,
  "can_be_overlay": false,
  "can_be_underlay": false,
  "can_be_nested": false,
  "repeatable": false,
  "known_limitations": [
    "TCP reverse transport only; token authentication does not encrypt payload",
    "Peer transport listener and local-only payload listener; no global optimizations"
  ],
  "verification": "UNTESTED",
  "supported_os": [
    "linux"
  ],
  "supported_arch": [
    "amd64",
    "arm64"
  ],
  "implementation_status": "IMPLEMENTED"
}
