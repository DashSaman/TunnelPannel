{
  "id": "waterwall",
  "name": "WaterWall",
  "family": "proxy",
  "version": "1.x",
  "maturity": "EXPERIMENTAL",
  "layer": "L4",
  "transport": [
    "tcp"
  ],
  "requires": [
    "TCP_STREAM"
  ],
  "provides": [
    "TCP_STREAM",
    "REVERSE_TCP",
    "TLS"
  ],
  "required_binaries": [
    "waterwall"
  ],
  "required_kernel_modules": [],
  "required_privileges": "none",
  "ports": {
    "tcp": "any"
  },
  "ip_protocols": [],
  "ipv4": true,
  "ipv6": true,
  "tun": false,
  "tap": false,
  "socks": false,
  "http_proxy": false,
  "reverse": true,
  "raw_ip": false,
  "encryption": "TLS optional",
  "mtu_overhead": 10,
  "can_be_overlay": true,
  "can_be_underlay": true,
  "can_be_nested": true,
  "repeatable": true,
  "known_limitations": [
    "config-driven; fewer distro packages"
  ],
  "verification": "LAB_VERIFIED",
  "supported_os": [
    "linux"
  ],
  "supported_arch": [
    "amd64",
    "arm64"
  ],
  "implementation_status": "IMPLEMENTED"
}
