{
  "id": "ip4in6",
  "name": "Native 4in6",
  "family": "kernel",
  "version": "linux",
  "maturity": "ADVANCED",
  "layer": "L3",
  "transport": [
    "ip"
  ],
  "requires": [
    "RAW_IP"
  ],
  "provides": [
    "L3_INTERFACE",
    "RAW_IP"
  ],
  "required_binaries": [
    "ip"
  ],
  "required_kernel_modules": [],
  "required_privileges": "CAP_NET_ADMIN",
  "ports": {},
  "ip_protocols": [
    4
  ],
  "ipv4": true,
  "ipv6": true,
  "tun": false,
  "tap": false,
  "socks": false,
  "http_proxy": false,
  "reverse": false,
  "raw_ip": true,
  "encryption": "none",
  "mtu_overhead": 40,
  "can_be_overlay": true,
  "can_be_underlay": true,
  "can_be_nested": true,
  "repeatable": true,
  "known_limitations": [
    "Native global IPv6 endpoints required; IPv4 payload only; IPv6 next-header4 must pass",
    "Keyless carriers share only proven-owned endpoints; foreign matching carrier blocks deployment"
